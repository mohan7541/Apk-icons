
import android.content.Context;
import android.content.SharedPreferences;
import android.os.Build;
import android.security.keystore.KeyGenParameterSpec;
import android.security.keystore.KeyProperties;
import android.util.Base64;
import android.util.Log;

import org.bouncycastle.jce.provider.BouncyCastleProvider;

import java.nio.charset.StandardCharsets;
import java.security.KeyFactory;
import java.security.KeyPair;
import java.security.KeyPairGenerator;
import java.security.KeyStore;
import java.security.PrivateKey;
import java.security.Provider;
import java.security.spec.MGF1ParameterSpec;
import java.security.spec.PKCS8EncodedKeySpec;

import javax.crypto.Cipher;
import javax.crypto.KeyGenerator;
import javax.crypto.SecretKey;
import javax.crypto.spec.GCMParameterSpec;
import javax.crypto.spec.OAEPParameterSpec;
import javax.crypto.spec.PSource;

/**
 * OAEP-SHA256 + MGF1-SHA256 on every Android version (minSdk 23).
 *  - API 34+  : RSA key lives in AndroidKeyStore (hardware-backed where available)
 *  - API 23-33: RSA key generated with BouncyCastle, private key wrapped by a Keystore AES key
 *
 * Gradle: implementation 'org.bouncycastle:bcprov-jdk18on:1.78.1'
 */
public class RsaCryptoManager {

    private static final String TAG = "RsaCryptoManager";
    private static final String AKS = "AndroidKeyStore";
    private static final String RSA_ALIAS = "enc_rsa_key";
    private static final String WRAP_ALIAS = "enc_wrap_key";
    private static final String PREFS = "rsa_prefs";
    private static final String TRANSFORMATION = "RSA/ECB/OAEPWithSHA-256AndMGF1Padding";

    private static final String MODE_KEYSTORE = "KEYSTORE_V2";
    private static final String MODE_SOFTWARE = "SOFTWARE_V2";

    private static final Provider BC = new BouncyCastleProvider();

    private final SharedPreferences prefs;
    private final boolean useKeystoreRsa = Build.VERSION.SDK_INT >= 34;

    private PrivateKey cachedPrivateKey; // used for software mode
    private String publicKeyBase64;

    public RsaCryptoManager(Context context) {
        this.prefs = context.getApplicationContext()
                .getSharedPreferences(PREFS, Context.MODE_PRIVATE);
    }

    /** Call once (off the main thread). Returns true if a NEW key was created,
     *  meaning you must send getPublicKeyBase64() to the server again. */
    public synchronized boolean init() throws Exception {
        String expectedMode = useKeystoreRsa ? MODE_KEYSTORE : MODE_SOFTWARE;
        String savedMode = prefs.getString("mode", null);

        if (expectedMode.equals(savedMode) && keyExists()) {
            publicKeyBase64 = prefs.getString("pub", null);
            if (publicKeyBase64 != null) return false;
        }

        // Old/missing/mismatched key (first run, old config, OS upgrade, restored backup): regenerate
        clearAll();
        if (useKeystoreRsa) {
            generateKeystoreRsa();
        } else {
            generateSoftwareRsa();
        }
        prefs.edit().putString("mode", expectedMode).apply();
        return true;
    }

    public String getPublicKeyBase64() {
        return publicKeyBase64;
    }

    public synchronized String decrypt(String encryptedData) throws Exception {
        String cleaned = encryptedData.trim().replace(" ", "+").replaceAll("\\s", "");
        byte[] cipherData;
        try {
            cipherData = Base64.decode(cleaned, Base64.DEFAULT);
        } catch (IllegalArgumentException e) {
            cipherData = Base64.decode(cleaned, Base64.URL_SAFE);
        }

        OAEPParameterSpec spec = new OAEPParameterSpec(
                "SHA-256", "MGF1", MGF1ParameterSpec.SHA256, PSource.PSpecified.DEFAULT);

        Cipher cipher;
        PrivateKey privateKey;
        if (useKeystoreRsa) {
            KeyStore ks = KeyStore.getInstance(AKS);
            ks.load(null);
            privateKey = (PrivateKey) ks.getKey(RSA_ALIAS, null);
            cipher = Cipher.getInstance(TRANSFORMATION);
        } else {
            privateKey = loadSoftwarePrivateKey();
            cipher = Cipher.getInstance(TRANSFORMATION, BC);
        }
        if (privateKey == null) throw new IllegalStateException("Private key missing");

        cipher.init(Cipher.DECRYPT_MODE, privateKey, spec);
        return new String(cipher.doFinal(cipherData), StandardCharsets.UTF_8);
    }

    // ---------------- API 34+ : Keystore RSA ----------------

    private void generateKeystoreRsa() throws Exception {
        KeyPairGenerator kpg = KeyPairGenerator.getInstance(KeyProperties.KEY_ALGORITHM_RSA, AKS);
        kpg.initialize(new KeyGenParameterSpec.Builder(
                RSA_ALIAS, KeyProperties.PURPOSE_ENCRYPT | KeyProperties.PURPOSE_DECRYPT)
                .setKeySize(2048)
                .setEncryptionPaddings(KeyProperties.ENCRYPTION_PADDING_RSA_OAEP)
                .setDigests(KeyProperties.DIGEST_SHA256)
                .setMgf1Digests(KeyProperties.DIGEST_SHA256)
                .build());
        kpg.generateKeyPair();

        KeyStore ks = KeyStore.getInstance(AKS);
        ks.load(null);
        byte[] pub = ks.getCertificate(RSA_ALIAS).getPublicKey().getEncoded();
        publicKeyBase64 = Base64.encodeToString(pub, Base64.NO_WRAP);
        prefs.edit().putString("pub", publicKeyBase64).apply();
    }

    // ---------------- API 23-33 : BouncyCastle RSA wrapped by Keystore AES ----------------

    private void generateSoftwareRsa() throws Exception {
        KeyPairGenerator kpg = KeyPairGenerator.getInstance("RSA", BC);
        kpg.initialize(2048);
        KeyPair kp = kpg.generateKeyPair();

        Cipher aes = Cipher.getInstance("AES/GCM/NoPadding");
        aes.init(Cipher.ENCRYPT_MODE, getOrCreateWrapKey());
        byte[] encPriv = aes.doFinal(kp.getPrivate().getEncoded());

        publicKeyBase64 = Base64.encodeToString(kp.getPublic().getEncoded(), Base64.NO_WRAP);
        prefs.edit()
                .putString("pub", publicKeyBase64)
                .putString("priv", Base64.encodeToString(encPriv, Base64.NO_WRAP))
                .putString("iv", Base64.encodeToString(aes.getIV(), Base64.NO_WRAP))
                .apply();
        cachedPrivateKey = kp.getPrivate();
    }

    private PrivateKey loadSoftwarePrivateKey() throws Exception {
        if (cachedPrivateKey != null) return cachedPrivateKey;

        byte[] encPriv = Base64.decode(prefs.getString("priv", ""), Base64.NO_WRAP);
        byte[] iv = Base64.decode(prefs.getString("iv", ""), Base64.NO_WRAP);

        Cipher aes = Cipher.getInstance("AES/GCM/NoPadding");
        aes.init(Cipher.DECRYPT_MODE, getOrCreateWrapKey(), new GCMParameterSpec(128, iv));
        byte[] privBytes = aes.doFinal(encPriv);

        cachedPrivateKey = KeyFactory.getInstance("RSA", BC)
                .generatePrivate(new PKCS8EncodedKeySpec(privBytes));
        return cachedPrivateKey;
    }

    private SecretKey getOrCreateWrapKey() throws Exception {
        KeyStore ks = KeyStore.getInstance(AKS);
        ks.load(null);
        if (ks.containsAlias(WRAP_ALIAS)) {
            return ((KeyStore.SecretKeyEntry) ks.getEntry(WRAP_ALIAS, null)).getSecretKey();
        }
        KeyGenerator kg = KeyGenerator.getInstance(KeyProperties.KEY_ALGORITHM_AES, AKS);
        kg.init(new KeyGenParameterSpec.Builder(
                WRAP_ALIAS, KeyProperties.PURPOSE_ENCRYPT | KeyProperties.PURPOSE_DECRYPT)
                .setBlockModes(KeyProperties.BLOCK_MODE_GCM)
                .setEncryptionPaddings(KeyProperties.ENCRYPTION_PADDING_NONE)
                .setKeySize(256)
                .build());
        return kg.generateKey();
    }

    // ---------------- helpers ----------------

    private boolean keyExists() {
        try {
            if (useKeystoreRsa) {
                KeyStore ks = KeyStore.getInstance(AKS);
                ks.load(null);
                return ks.containsAlias(RSA_ALIAS);
            }
            // Software mode: stored key AND the wrapping key must both exist,
            // and the wrapped key must actually be decryptable.
            if (!prefs.contains("priv") || !prefs.contains("iv")) return false;
            loadSoftwarePrivateKey();
            return true;
        } catch (Exception e) {
            Log.w(TAG, "Existing key unusable, will regenerate", e);
            return false;
        }
    }

    private void clearAll() {
        cachedPrivateKey = null;
        prefs.edit().clear().apply();
        try {
            KeyStore ks = KeyStore.getInstance(AKS);
            ks.load(null);
            if (ks.containsAlias(RSA_ALIAS)) ks.deleteEntry(RSA_ALIAS);
            if (ks.containsAlias(WRAP_ALIAS)) ks.deleteEntry(WRAP_ALIAS);
        } catch (Exception e) {
            Log.w(TAG, "Failed clearing keystore", e);
        }
    }
}
